<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- package visibility for targetSdk 30+: list installed host apps + read framework signatures -->
    <queries>
        <package android:name="android" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Keeps the container process out of the cached/frozen bucket: a whole
         Android system runs in this process while it is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:name=".TwoyiApplication"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Twoyi" >

        <activity android:name=".Render2Activity"
            android:theme="@style/Theme.Twoyi.FullScreen"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity>


        <activity
            android:name=".ui.AboutActivity"
            android:label="@string/about_btn"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SelectAppActivity"
            android:label="@string/create_app_activity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.twoyi.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <provider
            android:name=".provider.TwoyiDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Pins the container process out of the cached/frozen state while
             the container runs in the background. Not exported: it is started
             by this app only, and stopWithTask=false keeps it alive when the
             task is swiped away (the container keeps running by design). -->
        <service
            android:name=".ContainerService"
            android:exported="false"
            android:stopWithTask="false" />

    </application>

</manifest>